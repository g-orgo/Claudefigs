{
  "description": "Detects prompts, or files they point to, with several numbered requests and hints the split skill.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/detect_multi.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/detect_read.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "./split-pane/register.tsx"
  ]
}
