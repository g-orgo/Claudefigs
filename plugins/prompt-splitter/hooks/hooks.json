{
  "description": "Detects prompts, or files they point to, with several numbered requests and hints the split skill.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/detect_multi.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/detect_read.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_SPLIT_CHILD\" = 1 ] && python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hide_resume.py\" --hook || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_SPLIT_CHILD\" = 1 ] && python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hide_resume.py\" --hook --defer || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hide_resume.py\" --all --quiet >/dev/null 2>&1 &) ; true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./split-pane/register.tsx"
  ]
}
